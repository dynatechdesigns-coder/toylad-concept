{
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/daily-digest", "schedule": "0 6 * * *" }],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
